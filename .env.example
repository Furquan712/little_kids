# MongoDB (local development)
MONGODB_URI=mongodb://127.0.0.1:27017/nanny_platform

# Auth.js
AUTH_SECRET=replace-with-a-long-random-string

# Cloudinary (private/authenticated delivery, signed URLs)
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret
# Optional: only needed for time-limited signed URLs. Set this to a hex
# secret of your choosing AND set the same value as the "Auth Token Key"
# in Cloudinary Settings > Security > Token-based authentication.
CLOUDINARY_AUTH_TOKEN_KEY=

# Brevo (transactional email + SMS)
# Leave BREVO_API_KEY empty in local dev to fall back to console logging.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Nanny Platform
BREVO_SMS_SENDER=NannyApp

# Base URL used to build verification/reset links
APP_BASE_URL=http://localhost:3000
